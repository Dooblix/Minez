>1x+79#+33#-54#-26#>7. // Take operator input
>1x+10#+68#+39#-8#-59#+8#-26#>8: // Take second int input

>1x+32 // load sp for prettier output

// Case '+'
{7=2}(
    >6@#!>1#>7#>1#>8#!_>1#x+61#-29#>8#!;
)

// Case '-'
{7=3}( 
    >1x+32
    >6#!>1#>7#>1#>8#!>1#
    // This next step enables us to use stack operations. We'll take the additive inverse of b and add it to a using '_'
    {8>0}( // creates negative version of b if b > 0 to prevent the use of loops
        >8[>9-1>8-]
    )
    {8<0}( // creates positive version of b if b < 0 to prevent the use of loops
        >8[>9+>8+]
    )
    >9@>6_>1x+61#-29#>6#!;
)

// Case '*'
{7=4}(
    >6#!>1#>7#>1#>8#!>1#
    {6>0}(
        >6[>8@>9_>6-] // accumulatively adds a to b using '_' a-times
    )
    {6<0}(
        {8>0}(
            >8[>6@>9_>8-] // uses b as counter if a < 0
        )
        {8<0}(
            [>10+>8+]>6[>10@>9_>6+] // creates additive inverse of b and uses a as counter (negative, up) if both a and b > 0
        )
    )
    >1x+61#-29#>9#!;
)

// Case '/' (uses repeated subtraction method)
{7=5}(
    >6#!>1#>7#>1#>8#!>1#
    {8=0}(
        >1x+10#+59#+45##-3#+3#-56#-26#+68#+5#+13#-13#+10#-10#+6#-1#-78#+66#+23#-89#+90#-21#+13#-3#; // ZeroDivisionError-Message
    )

    // inversion and setting of negative flag
    {6<0}(
        {8>0}(
            >12+>6@x>0_[>6+>0+] // inverts a and sets negative flag
        )
        {8<0}(
            >6@x>0_[>6+>0+]>8@x>0_[>8+>0+] // inverts a and b
        )
    )
    {6>0}(
        {8<0}(
            >12+>8@x>0_[>8+>0+] // inverts b and sets negative flag
        )
    )
    

    >8@>10_>8[>11-1>8-] // copys b for comparing and creates additive inverse for subtracting from remainder
    >6[{6<10}(>0~)>11@>6_>9+] // actual algorithm: repeatedly subtracts b from a and increments a variable until a < b
    >1x+61#-29#{12>0}(>3#)>9#!{6>0}(>1#+82#-82#>6#!); // Output: remainder is only outputted if its > 0, prints a '-' before result if negative flag was set
)
